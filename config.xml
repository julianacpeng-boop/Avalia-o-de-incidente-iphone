<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.curiosidadesenclinica.chamadorapidoios12" version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Chamado Rápido EC</name>
  <description>Chamados rápidos por QR Code para a Engenharia Clínica</description>
  <author email="julianacp.eng@gmail.com">Engenharia Clínica</author>
  <content src="index.html" />

  <access origin="*" />
  <allow-navigation href="https://wa.me/*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="whatsapp:*" />

  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="false" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="deployment-target" value="12.0" />
  <preference name="target-device" value="handset" />
  <preference name="SplashScreenBackgroundColor" value="#06483D" />
  <preference name="FadeSplashScreenDuration" value="500" />

  <platform name="ios">
    <preference name="deployment-target" value="12.0" />
    <preference name="target-device" value="handset" />

    <edit-config file="*-Info.plist" mode="merge" target="NSCameraUsageDescription">
      <string>A câmera é usada somente para ler o QR Code do equipamento.</string>
    </edit-config>
    <edit-config file="*-Info.plist" mode="merge" target="NSPhotoLibraryUsageDescription">
      <string>O acesso às fotos permite escolher uma imagem contendo o QR Code do equipamento.</string>
    </edit-config>

    <icon src="resources/ios/icon-38@2x.png" width="76" height="76" />
    <icon src="resources/ios/icon-38@3x.png" width="114" height="114" />
    <icon src="resources/ios/icon-29@1x.png" width="29" height="29" />
    <icon src="resources/ios/icon-29@2x.png" width="58" height="58" />
    <icon src="resources/ios/icon-29@3x.png" width="87" height="87" />
    <icon src="resources/ios/icon-40@1x.png" width="40" height="40" />
    <icon src="resources/ios/icon-40@2x.png" width="80" height="80" />
    <icon src="resources/ios/icon-60@1x.png" width="60" height="60" />
    <icon src="resources/ios/icon-60@2x.png" width="120" height="120" />
    <icon src="resources/ios/icon-60@3x.png" width="180" height="180" />
    <icon src="resources/ios/icon-76@2x.png" width="152" height="152" />
    <icon src="resources/ios/icon-83.5@2x.png" width="167" height="167" />
    <icon src="resources/ios/icon-1024.png" width="1024" height="1024" />

    <splash src="resources/ios/Default@2x~iphone.png" width="640" height="960" />
    <splash src="resources/ios/Default-568h@2x~iphone.png" width="640" height="1136" />
    <splash src="resources/ios/Default-667h.png" width="750" height="1334" />
    <splash src="resources/ios/Default-736h@3x~iphone.png" width="1242" height="2208" />
  </platform>
</widget>
